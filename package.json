{
  "name": "lams",
  "version": "0.1.0",
  "private": true,
  "description": "LTP Approval Management System — building permission approval platform",
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "tsx --conditions=react-server --env-file-if-exists=.env prisma/seed/index.ts"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx --conditions=react-server --env-file-if-exists=.env worker/index.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:seed": "tsx --conditions=react-server --env-file-if-exists=.env prisma/seed/index.ts",
    "seed:demo": "tsx --conditions=react-server --env-file-if-exists=.env prisma/seed/demo/index.ts",
    "seed:demo:reset": "LAMS_ALLOW_DEMO_RESET=1 tsx --conditions=react-server --env-file-if-exists=.env prisma/seed/demo/index.ts --reset",
    "demo:verify": "tsx --conditions=react-server --env-file-if-exists=.env scripts/verify-demo.ts",
    "demo:phase4": "tsx --conditions=react-server --env-file-if-exists=.env scripts/enrich-phase4.ts",
    "db:reset": "prisma migrate reset --force",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "bbas:align": "tsx --conditions=react-server --env-file-if-exists=.env scripts/align-bbas-workflow.ts",
    "shortfalls:enrich": "tsx --conditions=react-server --env-file-if-exists=.env scripts/enrich-shortfalls.ts",
    "orders:backfill": "tsx --conditions=react-server --env-file-if-exists=.env scripts/backfill-orders.ts",
    "bim:backfill": "tsx --conditions=react-server --env-file-if-exists=.env scripts/backfill-bim.ts",
    "smoke": "tsx --conditions=react-server --env-file-if-exists=.env scripts/smoke.ts",
    "inspections:seed": "tsx --conditions=react-server --env-file-if-exists=.env scripts/seed-site-inspections.ts",
    "nocs:config": "tsx --conditions=react-server --env-file-if-exists=.env scripts/seed-noc-config.ts",
    "nocs:seed": "tsx --conditions=react-server --env-file-if-exists=.env scripts/seed-nocs.ts",
    "proceedings:config": "tsx --conditions=react-server --env-file-if-exists=.env scripts/seed-proceedings-config.ts",
    "proceedings:seed": "tsx --conditions=react-server --env-file-if-exists=.env scripts/seed-proceedings.ts",
    "tpchange:config": "tsx --conditions=react-server --env-file-if-exists=.env scripts/seed-professional-change-config.ts",
    "tpchange:seed": "tsx --conditions=react-server --env-file-if-exists=.env scripts/seed-professional-changes.ts",
    "tpchange:verify": "tsx --conditions=react-server --env-file-if-exists=.env scripts/verify-professional-change.ts",
    "commencement:config": "tsx --conditions=react-server --env-file-if-exists=.env scripts/seed-commencement-config.ts",
    "commencement:seed": "tsx --conditions=react-server --env-file-if-exists=.env scripts/seed-work-commencements.ts",
    "commencement:verify": "tsx --conditions=react-server --env-file-if-exists=.env scripts/verify-commencement.ts",
    "demo:approved": "tsx --conditions=react-server --env-file-if-exists=.env scripts/seed-post-approval-files.ts",
    "occupancy:config": "tsx --conditions=react-server --env-file-if-exists=.env scripts/seed-occupancy-config.ts",
    "occupancy:seed": "tsx --conditions=react-server --env-file-if-exists=.env scripts/seed-occupancy.ts",
    "occupancy:verify": "tsx --conditions=react-server --env-file-if-exists=.env scripts/verify-occupancy.ts",
    "developers:config": "tsx --conditions=react-server --env-file-if-exists=.env scripts/seed-developer-config.ts",
    "developers:seed": "tsx --conditions=react-server --env-file-if-exists=.env scripts/seed-developers.ts",
    "developers:verify": "tsx --conditions=react-server --env-file-if-exists=.env scripts/verify-developer-registration.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.3.1",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "fflate": "^0.8.3",
    "jose": "^5.9.6",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.474.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.86.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.0",
    "eslint-config-next": "^15.1.7",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^6.3.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
