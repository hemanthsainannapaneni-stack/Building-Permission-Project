// ═══════════════════════════════════════════════════════════════════════════
// 14. PLATFORM
// ═══════════════════════════════════════════════════════════════════════════

/// Append-only and hash-chained. The application DB role is granted INSERT and
/// SELECT only — see the constraints migration.
model AuditLog {
  id            Int      @id @default(autoincrement())
  actorId       String?
  actorName     String   @default("")
  actorRoleKey  String   @default("")
  action        String
  entityType    String
  entityId      String
  applicationId String?
  before        Json?
  after         Json?
  remarks       String   @default("")
  ip            String   @default("")
  userAgent     String   @default("")
  /// Request trace id. Stays TEXT, not uuid: it is accepted from an inbound
  /// x-correlation-id header, so a caller or proxy may set it to anything.
  correlationId String   @default("")
  /// Tamper evidence: sha256(prevHash + canonical(row)).
  prevHash      String   @default("")
  rowHash       String   @default("")
  occurredAt    DateTime @default(now())
  /// Append order, and the ONLY order the chain may be walked in.
  /// `occurredAt` is a millisecond timestamp that rows routinely tie on, and
  /// two rows in the same millisecond can be read in either order — which
  /// would report a break in a chain that was intact.
  seq           Int      @unique @default(0)

  @@index([entityType, entityId])
  @@index([applicationId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([action, occurredAt])
  @@index([occurredAt])
  @@map("audit_logs")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  type        String   @default("STRING")
  group       String   @default("general")
  label       String   @default("")
  description String   @default("")
  /// Never serialised to a client.
  isSecret    Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@index([group])
  @@map("system_settings")
}

// ═══════════════════════════════════════════════════════════════════════════
// 11. SITE INSPECTION
// ═══════════════════════════════════════════════════════════════════════════

/// One visit to the site by the inspecting TPA — TPA manual §5.8.
///
/// ── One row per ROUND, never re-used ──────────────────────────────────────
///
/// A file can be inspected more than once: the report raises a shortfall, the
/// applicant corrects the site, and the TPA goes back. The second visit is a
/// second row with `round = 2`. The first report is signed, and a signed
/// report is never edited — so a re-inspection cannot be expressed as an
/// update to it without destroying the thing the signature was over.
///
/// ── Why the wording of each question is copied onto the response ─────────
///
/// The 27 questions are configuration (`checklist_item_definitions`, kind
/// SITE_INSPECTION) and they are PROVISIONAL DEMO WORDING — the manuals do not
/// reproduce them as text, so an administrator will replace them. A report
/// signed today must still read tomorrow exactly as it did when it was
/// signed, which is only true if the question the inspector answered travels
/// with the answer. See SiteInspectionResponse.
///
/// ── The workflow link ─────────────────────────────────────────────────────
///
/// Scheduling and submission are each ONE transaction with a workflow
/// transition (`SCHEDULE_SITE_INSPECTION`, `SUBMIT_SITE_INSPECTION`,
/// `RAISE_INSPECTION_SHORTFALL`). `scheduleSequence` and `submitSequence`
/// name the `workflow_history` rows those transitions wrote, so the movement
/// history and the inspection each point at the other.
model SiteInspection {
  id               String @id @default(uuid())
  /// SI/2026/000001 — allocated in the scheduling transaction, gap-free.
  inspectionNumber String @unique
  applicationId    String
  round            Int    @default(1)

  /// SCHEDULED | IN_PROGRESS | SUBMITTED — src/lib/site-inspection.ts.
  status String @default("SCHEDULED")

  // ── Who and when ─────────────────────────────────────────────────────
  inspectorId     String
  inspectorName   String
  scheduledById   String?
  scheduledByName String    @default("")
  /// The date the visit is booked for.
  scheduledFor    DateTime
  scheduleRemarks String    @default("")
  /// The date the visit actually happened, as recorded by the inspector.
  inspectedAt     DateTime?
  /// The desk the file was at when this was scheduled.
  stageCode       String    @default("")

  // ── Where ────────────────────────────────────────────────────────────
  /// DEMO COORDINATES. No GPS is read from any device; see
  /// `demoSiteLocation()`. `locationSource` says so on every row.
  latitude       Float?
  longitude      Float?
  locationSource String @default("DEMO")
  siteAddress    String @default("")

  generalObservation String @default("")

  // ── The finding ──────────────────────────────────────────────────────
  /// RECOMMENDED | SHORTFALL | REJECT. Empty until the inspector decides.
  recommendation        String @default("")
  recommendationRemarks String @default("")

  // ── The signature (DEMO) ─────────────────────────────────────────────
  /// AADHAAR_ESIGN_DEMO | USB_TOKEN_DEMO. Neither is a real signature.
  signatureMethod   String    @default("")
  signedById        String?
  signedByName      String    @default("")
  signedByRoleKey   String    @default("")
  signedAt          DateTime?
  /// Demo transaction reference, e.g. ESIGN-DEMO-7F3A…
  signatureRef      String    @default("")
  /// SHA-256 over the canonical report. Recomputing it from the rows proves
  /// the report has not changed since it was signed.
  documentHash      String    @default("")
  /// Everything else the demo provider "returned" — certificate subject,
  /// masked Aadhaar, token serial. Shown on the report, never trusted.
  signatureMetadata Json      @default(dbgenerated("'{}'"))

  submittedAt DateTime?
  /// Set with `submittedAt`. A locked inspection accepts no write of any kind.
  lockedAt    DateTime?

  // ── The workflow link ────────────────────────────────────────────────
  scheduleSequence Int?
  scheduleLinkedAt DateTime?
  submitSequence   Int?
  routedAt         DateTime?
  routedActionCode String    @default("")
  /// The shortfall this report raised, when its recommendation was SHORTFALL.
  shortfallId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application Application              @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  inspector   User                     @relation("SiteInspectionInspector", fields: [inspectorId], references: [id])
  responses   SiteInspectionResponse[]
  photos      SiteInspectionPhoto[]

  @@unique([applicationId, round])
  @@index([status, scheduledFor])
  @@index([inspectorId, status])
  @@index([recommendation])
  @@map("site_inspections")
}

/// One question of the 27, answered on site.
///
/// `question`, `category` and `isProvisional` are SNAPSHOTS of the definition
/// as it stood when the answer was written. The definition row is editable
/// and is expected to be edited — the provisional wording is replaced once
/// the official text is available — and a signed report must not change
/// underneath its signature when that happens.
model SiteInspectionResponse {
  id           String @id @default(uuid())
  inspectionId String
  itemId       String
  itemNumber   Int

  question      String
  category      String  @default("")
  responseType  String  @default("YES_NO_NA")
  isMandatory   Boolean @default(true)
  isProvisional Boolean @default(true)

  /// YES | NO | NA, or free text / a number for the other response types.
  response    String @default("")
  /// What was seen on the ground.
  observation String @default("")
  remarks     String @default("")
  /// PENDING | SATISFACTORY | SHORTFALL | OBJECTION | NA.
  status      String @default("PENDING")

  answeredById String?
  answeredAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inspection SiteInspection          @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  item       ChecklistItemDefinition @relation(fields: [itemId], references: [id])

  @@unique([inspectionId, itemId])
  @@index([inspectionId, itemNumber])
  @@map("site_inspection_responses")
}

/// A geo-tagged photograph taken at the site.
///
/// The coordinates and the capture time are what make it evidence rather than
/// a picture, so they are REQUIRED. In this demonstration they are DEMO
/// coordinates entered with the photo — no EXIF is parsed and no device GPS
/// is read — and `isDemoLocation` records that on the row itself.
///
/// `fileObjectId` is a plain id, not a relation, for the same reason
/// `documentId` is on checklist responses: the photograph references a stored
/// file, and the lifecycle of the file is the storage layer's business. A row
/// with no file is a seeded demo photograph, rendered as a labelled
/// placeholder by the image route.
model SiteInspectionPhoto {
  id            String @id @default(uuid())
  inspectionId  String
  applicationId String

  /// NORTH | SOUTH | EAST | WEST | ACCESS_ROAD | BOUNDARY | ENCUMBRANCE |
  /// EXISTING_STRUCTURE | OTHER
  category    String
  description String @default("")

  fileObjectId String?
  fileName     String  @default("")
  mimeType     String  @default("")
  sizeBytes    Int     @default(0)

  latitude       Float
  longitude      Float
  capturedAt     DateTime
  isDemoLocation Boolean  @default(true)

  uploadedById   String
  uploadedByName String   @default("")
  uploadedAt     DateTime @default(now())

  inspection SiteInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId, category])
  @@index([applicationId])
  @@map("site_inspection_photos")
}

/// The statutory checklists, as configuration.
///
/// Two of them today:
///
///   APPLICATION       the 19-point checklist the LTP answers and the TPA,
///                     Planning Officer, ZDD and ZJD verify
///   SITE_INSPECTION   the 27-point checklist the TPA completes on site
///
/// ── Why the wording is a row and not a constant ──────────────────────────
///
/// THE OFFICIAL WORDING IS NOT YET AVAILABLE. The four BBAS manuals describe
/// both checklists and show them in screenshots, but neither reproduces the
/// questions as text — the TPA manual says only that questions 1 to 10 cover
/// "ownership validity, encumbrance status, master plan zoning, and layout
/// compliance", and so on. Inventing sentences and presenting them as
/// statutory requirements would be worse than useless.
///
/// So every question carries `isProvisional`, and while it is true the
/// interface says so wherever the question is shown. The wording is editable
/// from the administration screens, which means replacing it when the official
/// text arrives is a data change — no migration, no deployment, no code.
///
/// Responses are NOT modelled here. They arrive with the modules that collect
/// them (the application checklist tab, the site inspection subsystem) and
/// will reference these rows.
model ChecklistItemDefinition {
  id String @id @default(uuid())

  /// APPLICATION | SITE_INSPECTION
  kind       String
  /// The number the question is known by — "question 14". Stable, and separate
  /// from `displayOrder` so a checklist can be reordered without renumbering
  /// questions that officers and letters refer to by number.
  itemNumber Int

  question    String
  description String @default("")

  /// YES_NO | YES_NO_NA | TEXT | NUMBER | MEASUREMENT
  responseType String @default("YES_NO_NA")
  /// Groups the items into sections on screen. Free text, administrator-set.
  category     String @default("")
  helpText     String @default("")

  isMandatory      Boolean @default(true)
  /// The answer is expected to be backed by an uploaded document.
  requiresDocument Boolean @default(false)
  /// The answer feeds the application's risk category.
  affectsRisk      Boolean @default(false)

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  /// True while this is demo wording rather than the official BBAS question.
  /// Surfaced in the interface; set to false when the real text is entered.
  isProvisional Boolean @default(true)
  /// Where the wording came from — a manual section, a rule, or the note that
  /// it is provisional. Shown to the administrator editing it.
  source        String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses           ApplicationChecklistResponse[]
  inspectionResponses SiteInspectionResponse[]

  @@unique([kind, itemNumber])
  @@index([kind, isActive, displayOrder])
  @@map("checklist_item_definitions")
}

/// One application's answer to one checklist question.
///
/// ── Why there are two responses on one row ──────────────────────────────
///
/// `response` is the APPLICANT'S answer and `reviewerResponse` is the
/// REVIEWER'S. They are separate columns and never overwrite one another,
/// because the interesting case is the one where they DIFFER: the LTP
/// answered "yes, the encumbrance certificate is enclosed" and the TPA found
/// it expired. A single column would record only the last person to type,
/// and the disagreement — which is the entire reason an officer reviews a
/// checklist — would be invisible the moment it was resolved.
///
/// ── Why this row is not the record ──────────────────────────────────────
///
/// This row is the CURRENT state, for reading cheaply. The record is
/// `checklist_review_entries`, which is append-only: every answer and every
/// verification is written there first and nothing is ever updated or
/// deleted. A ZDD who verifies a question the TPA marked SHORTFALL changes
/// what this row says and cannot touch what the TPA said — that history is a
/// different table with no update path. See reviewChecklist() in
/// src/server/services/application-checklist.ts.
///
/// `itemNumber` is denormalised on purpose. Officers, letters and shortfall
/// items refer to "question 14", and this answer must still be nameable as
/// question 14 after the definition row has been edited.
model ApplicationChecklistResponse {
  id            String @id @default(uuid())
  applicationId String
  itemId        String
  itemNumber    Int
  /// APPLICATION | SITE_INSPECTION. Copied from the definition so the
  /// application's checklists can be counted apart without a join.
  kind          String @default("APPLICATION")

  // ── The applicant's side ────────────────────────────────────────────
  /// The answer, in the vocabulary the question's responseType implies:
  /// YES | NO | NA for the yes/no kinds, free text or a number as a string
  /// for the others. Empty means UNANSWERED, which is what a new file is.
  response         String    @default("")
  applicantRemarks String    @default("")
  respondedById    String?
  respondedByName  String    @default("")
  respondedAt      DateTime?

  // ── The reviewer's side: the CURRENT verification ────────────────────
  reviewerResponse  String    @default("")
  reviewerRemarks   String    @default("")
  /// PENDING | VERIFIED | SHORTFALL | REJECTED | NA — src/lib/checklist.ts.
  status            String    @default("PENDING")
  reviewedById      String?
  reviewedByName    String    @default("")
  reviewedRoleKey   String    @default("")
  /// Which desk the verification was made at. Two desks reviewing the same
  /// question is normal and the screen shows both; without this the second
  /// one is indistinguishable from a correction of the first.
  reviewedStageCode String    @default("")
  reviewedAt        DateTime?

  /// The document offered in support, where the question calls for one. A
  /// plain id and not a relation, exactly as `shortfallItemId` is on
  /// `application_documents`: the reference is informational and must not
  /// cascade a document deletion into the checklist.
  documentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  item        ChecklistItemDefinition @relation(fields: [itemId], references: [id])
  entries     ChecklistReviewEntry[]

  @@unique([applicationId, itemId])
  @@index([applicationId, kind, itemNumber])
  @@index([applicationId, status])
  @@map("application_checklist_responses")
}

/// APPEND-ONLY. Every answer and every verification, in the order they
/// happened.
///
/// This table is the answer to "do not allow later reviewers to erase
/// previous responses". Not a convention and not a code path that could be
/// forgotten: there is no update and no delete anywhere in the service, the
/// screen reads this table for the history it shows beside each question,
/// and the application DB role has UPDATE and DELETE revoked on it by the
/// same constraints migration that protects `audit_logs` and
/// `workflow_history`.
///
/// A ZDD may reach a different conclusion from the TPA — that is what review
/// is for — and when they do, both conclusions are on the file with the desk
/// and the officer who reached each one.
model ChecklistReviewEntry {
  id            String @id @default(uuid())
  responseId    String
  applicationId String
  itemNumber    Int

  /// APPLICANT_RESPONSE | REVIEW
  entryType String
  response  String @default("")
  remarks   String @default("")
  /// The status set by this entry. Empty on an applicant's answer — an
  /// applicant states facts, they do not verify them.
  status    String @default("")

  actorId      String?
  actorName    String  @default("")
  actorRoleKey String  @default("")
  stageCode    String  @default("")

  recordedAt DateTime @default(now())

  response_   ApplicationChecklistResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  application Application                  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, itemNumber, recordedAt])
  @@index([responseId, recordedAt])
  @@map("checklist_review_entries")
}

/// The BBAS "Others" block — the six undertakings that travel with a building
/// permission but belong to none of the other tabs.
///
/// One row per application, created on demand. Every group follows the same
/// three-part shape wherever BBAS uses it — REQUIRED (the rule says so),
/// PROPOSED (the applicant says they will) and PROVIDED/INSTALLED (it is
/// there) — and the three are kept apart because the gap between them is the
/// whole point. A solar installation that is required and proposed and not
/// installed is the ordinary state of an application under consideration; one
/// that is required and not proposed is a shortfall. Collapsing them into a
/// single "solar: yes" would make those two indistinguishable.
model ApplicationOthers {
  id            String @id @default(uuid())
  applicationId String @unique

  // ── Mortgage ─────────────────────────────────────────────────────────
  /// The portion of the building mortgaged to the sanctioning authority as
  /// security, and the registration particulars of that deed.
  mortgageApplicable   Boolean   @default(false)
  mortgageNumber       String    @default("")
  mortgageDate         DateTime?
  mortgageSubRegistrar String    @default("")
  /// Which floors or which portion was handed over, as written in the deed.
  mortgagePortion      String    @default("")
  mortgageAreaSqm      Float?
  mortgageDocumentId   String?

  // ── Car insurance ────────────────────────────────────────────────────
  insuranceApplicable   Boolean   @default(false)
  insurancePolicyNumber String    @default("")
  insuranceDate         DateTime?
  insuranceValidUpto    DateTime?
  insuranceDocumentId   String?

  // ── Solar ────────────────────────────────────────────────────────────
  solarRequired   Boolean @default(false)
  solarProposed   Boolean @default(false)
  solarInstalled  Boolean @default(false)
  solarCapacityKw Float?
  solarRemarks    String  @default("")

  // ── Rainwater harvesting ─────────────────────────────────────────────
  rwhRequired Boolean @default(false)
  rwhProposed Boolean @default(false)
  rwhProvided Boolean @default(false)
  rwhRemarks  String  @default("")

  // ── Greening and trees ───────────────────────────────────────────────
  greeningRequired Boolean @default(false)
  greeningProposed Boolean @default(false)
  greeningProvided Boolean @default(false)
  /// Trees on the plot. NULL means not counted, which is not the same as a
  /// counted zero on a bare plot.
  treeCount        Int?
  greeningRemarks  String  @default("")

  /// Anything about this file that belongs on the permission and fits none of
  /// the headings above.
  specialRemarks String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_others")
}

/// Administrator-extensible lists — land use, occupancy, structure type.
/// Extending one must never need a migration.
model MasterData {
  id           String   @id @default(uuid())
  category     String
  code         String
  label        String
  parentCode   String?
  displayOrder Int      @default(0)
  metadata     Json     @default(dbgenerated("'{}'"))
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([category, code])
  @@index([category, isActive])
  @@map("master_data")
}

/// Transactional outbox — written INSIDE the business transaction, dispatched
/// by the worker. This is what guarantees an officer's action and the
/// applicant's SMS cannot diverge.
model OutboxEvent {
  id            String    @id @default(uuid())
  eventCode     String
  applicationId String?
  payload       Json
  processed     Boolean   @default(false)
  processedAt   DateTime?
  attempts      Int       @default(0)
  lastError     String    @default("")
  createdAt     DateTime  @default(now())

  @@index([processed, createdAt])
  @@map("outbox_events")
}

model Job {
  id          String    @id @default(uuid())
  type        String
  payload     Json      @default(dbgenerated("'{}'"))
  status      String    @default("PENDING")
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String    @default("")
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  /// Optional natural key — makes enqueueing idempotent.
  dedupeKey   String?   @unique

  @@index([status, runAt])
  @@map("jobs")
}

// ═══════════════════════════════════════════════════════════════════════════
// NOCs — no-objection certificates from external authorities
// ═══════════════════════════════════════════════════════════════════════════

/// A KIND of NOC, as configuration: Fire today; Airport, Railway, Environment,
/// Water Resources, Heritage and Other are seeded INACTIVE and switched on by
/// data, not code.
///
/// ── No legal thresholds live here ─────────────────────────────────────────
///
/// Whether a NOC is needed on a particular file is DECIDED BY THE REVIEWING
/// OFFICER and recorded on `application_nocs.isRequired`. Nothing computes it
/// from height, area or use. `suggestedByChecklistItems` only points at
/// application checklist questions whose YES answer is worth showing next to
/// that decision — the checklist wording itself is provisional (see
/// 12-checklists.ts) and a suggestion never marks anything required.
model NocType {
  id                        String  @id @default(uuid())
  /// FIRE | AIRPORT | RAILWAY | ENVIRONMENT | WATER_RESOURCES | HERITAGE | OTHER
  code                      String  @unique
  name                      String
  /// The authority that ordinarily issues it. Copied onto each NOC, where it
  /// can be corrected for that file.
  authority                 String  @default("")
  description               String  @default("")
  /// The document catalogue entry that matches it, e.g. FIRE_NOC. Informational.
  documentTypeCode          String  @default("")
  /// Application checklist item numbers (kind APPLICATION) whose YES answer
  /// suggests this NOC may apply. Never decisive.
  suggestedByChecklistItems Json    @default(dbgenerated("'[]'"))
  /// Whether the certificate carries a validity date the verifier must see.
  requiresExpiry            Boolean @default(true)
  isActive                  Boolean @default(true)
  displayOrder              Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nocs ApplicationNoc[]

  @@index([isActive, displayOrder])
  @@map("noc_types")
}

/// One NOC on one application. At most one per type per application.
///
/// Status vocabulary and the legal moves between statuses are in
/// src/lib/noc.ts. The applicant records the application to the authority and
/// the certificate received; the desk the file is at verifies, rejects, raises
/// a shortfall or marks it not required.
model ApplicationNoc {
  id            String @id @default(uuid())
  /// NOC/2026/000001 — gap-free, allocated in the creating transaction.
  nocNumber     String @unique
  applicationId String
  nocTypeId     String

  /// NOT_REQUIRED | REQUIRED | PENDING | APPLIED | RECEIVED | VERIFIED |
  /// SHORTFALL | REJECTED | EXPIRED
  status     String   @default("PENDING")
  /// Null until an officer determines it. PENDING rows are undetermined.
  isRequired Boolean?

  authority            String    @default("")
  /// The applicant's reference with the authority (the application number there).
  applicationReference String    @default("")
  /// The NOC's own number, as printed on the certificate.
  referenceNumber      String    @default("")
  appliedDate          DateTime?
  issuedDate           DateTime?
  expiryDate           DateTime?

  // ── The certificate ──────────────────────────────────────────────────
  /// A stored upload. Null with `isDemoDocument` for a demo placeholder.
  fileObjectId    String?
  fileName        String    @default("")
  mimeType        String    @default("")
  sizeBytes       Int       @default(0)
  isDemoDocument  Boolean   @default(false)
  documentAddedAt DateTime?

  // ── Verification ─────────────────────────────────────────────────────
  verifiedById      String?
  verifiedByName    String    @default("")
  verifiedByRoleKey String    @default("")
  verifiedAt        DateTime?
  /// The desk the file was at when an officer last decided on this NOC.
  reviewedStageCode String    @default("")
  /// The latest officer remarks — the shortfall asked, the reason for rejection.
  remarks           String    @default("")
  applicantRemarks  String    @default("")

  createdById   String?
  createdByName String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  nocType     NocType               @relation(fields: [nocTypeId], references: [id])
  events      ApplicationNocEvent[]

  @@unique([applicationId, nocTypeId])
  @@index([status])
  @@index([nocTypeId, status])
  @@index([expiryDate])
  @@map("application_nocs")
}

/// The lifecycle of one NOC, one row per move. Append-only by convention;
/// the audit chain carries the same facts tamper-evidently.
model ApplicationNocEvent {
  id           String   @id @default(uuid())
  nocId        String
  /// CREATED | MARK_REQUIRED | MARK_NOT_REQUIRED | RECORD_APPLICATION |
  /// RECORD_RECEIPT | VERIFY | REJECT | SHORTFALL | EXPIRE
  action       String
  fromStatus   String   @default("")
  toStatus     String
  actorId      String?
  actorName    String   @default("")
  actorRoleKey String   @default("")
  stageCode    String   @default("")
  remarks      String   @default("")
  occurredAt   DateTime @default(now())

  noc ApplicationNoc @relation(fields: [nocId], references: [id], onDelete: Cascade)

  @@index([nocId, occurredAt])
  @@map("application_noc_events")
}

// ═══════════════════════════════════════════════════════════════════════════
// 16. PROCEEDINGS — SHOW CAUSE, REVOCATION, OUTWARD
// ═══════════════════════════════════════════════════════════════════════════
//
// Three registers, deliberately separate from shortfalls. A shortfall asks the
// applicant for something the file lacks; a show cause notice asks them to
// explain something the department believes is wrong. They share no table, no
// number series, no status and no code path — see src/lib/show-cause.ts.
//
// Every officer decision on a show cause or a revocation is performed by the
// WORKFLOW ENGINE (a transition whose effect writes these rows), so who may
// issue, decide or revoke is `workflow_transitions` configuration, never code.

/// One show cause notice. Vocabulary and legal moves: src/lib/show-cause.ts.
model ShowCauseNotice {
  id            String @id @default(uuid())
  /// SCN/2026/000001 — its own series, never a shortfall number.
  noticeNumber  String @unique
  applicationId String

  /// ISSUED | AWAITING_RESPONSE | RESPONDED | UNDER_REVIEW | CLOSED |
  /// FURTHER_ACTION | REJECTED | REFERRED_FOR_REVOCATION
  status String @default("ISSUED")

  /// Why the notice is being issued — the officer's own words.
  reason          String
  /// The contravention alleged, as stated on the notice.
  violation       String
  /// The response window stated on the notice. Informational: nothing happens
  /// automatically when it passes.
  responseDueDate DateTime

  /// Demo attachments: [{ fileObjectId|null, fileName, mimeType, sizeBytes, isDemo }]
  supportingDocuments Json @default(dbgenerated("'[]'"))

  issuedById      String?
  issuedByName    String   @default("")
  issuedByRoleKey String   @default("")
  /// The desk the file was at when the notice was issued.
  issuedStageCode String   @default("")
  issuedAt        DateTime @default(now())
  /// The workflow history row that issued it.
  issueSequence   Int?

  // ── The applicant's response ────────────────────────────────────────
  responseText      String    @default("")
  responseDocuments Json      @default(dbgenerated("'[]'"))
  respondedById     String?
  respondedByName   String    @default("")
  respondedAt       DateTime?

  // ── The review and the decision ─────────────────────────────────────
  reviewerId       String?
  reviewerName     String    @default("")
  reviewerRoleKey  String    @default("")
  reviewStartedAt  DateTime?
  /// CLOSED_SATISFACTORY | FURTHER_ACTION_REQUIRED | REJECTED | REVOKE_PROCEEDING
  decision         String    @default("")
  decisionRemarks  String    @default("")
  decidedById      String?
  decidedByName    String    @default("")
  decidedByRoleKey String    @default("")
  decidedAt        DateTime?
  decisionSequence Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application Application            @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  events      ShowCauseEvent[]
  revocations RevocationProceeding[]

  @@index([applicationId])
  @@index([status])
  @@map("show_cause_notices")
}

/// Append-only by convention; the audit chain carries the same facts.
model ShowCauseEvent {
  id           String   @id @default(uuid())
  showCauseId  String
  action       String
  fromStatus   String   @default("")
  toStatus     String
  actorId      String?
  actorName    String   @default("")
  actorRoleKey String   @default("")
  stageCode    String   @default("")
  remarks      String   @default("")
  occurredAt   DateTime @default(now())

  showCause ShowCauseNotice @relation(fields: [showCauseId], references: [id], onDelete: Cascade)

  @@index([showCauseId, occurredAt])
  @@map("show_cause_events")
}

/// A proceeding to revoke a granted permission (the BPO).
/// PROPOSED → UNDER_REVIEW → REVOKED | REJECTED. See src/lib/revocation.ts.
model RevocationProceeding {
  id               String  @id @default(uuid())
  /// REV/2026/000001
  revocationNumber String  @unique
  applicationId    String
  /// The show cause whose decision referred the file here, when there was one.
  showCauseId      String?
  /// The BPO being proceeded against, frozen at initiation.
  orderNumber      String  @default("")

  status  String @default("PROPOSED")
  reason  String
  /// The grounds, one per line as stated by the initiating officer.
  grounds Json   @default(dbgenerated("'[]'"))

  initiatedById      String?
  initiatedByName    String   @default("")
  initiatedByRoleKey String   @default("")
  initiatedAt        DateTime @default(now())

  reviewerId      String?
  reviewerName    String    @default("")
  reviewerRoleKey String    @default("")
  reviewStartedAt DateTime?

  /// REVOKED | REJECTED
  decision         String    @default("")
  decisionRemarks  String    @default("")
  decidedById      String?
  decidedByName    String    @default("")
  decidedByRoleKey String    @default("")
  decidedAt        DateTime?

  /// ROR/2026/000001 — the revocation order, generated only on REVOKED.
  revocationOrderNumber String    @default("")
  orderGeneratedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  showCause   ShowCauseNotice?  @relation(fields: [showCauseId], references: [id])
  events      RevocationEvent[]

  @@index([applicationId])
  @@index([status])
  @@map("revocation_proceedings")
}

model RevocationEvent {
  id           String   @id @default(uuid())
  revocationId String
  action       String
  fromStatus   String   @default("")
  toStatus     String
  actorId      String?
  actorName    String   @default("")
  actorRoleKey String   @default("")
  stageCode    String   @default("")
  remarks      String   @default("")
  occurredAt   DateTime @default(now())

  revocation RevocationProceeding @relation(fields: [revocationId], references: [id], onDelete: Cascade)

  @@index([revocationId, occurredAt])
  @@map("revocation_events")
}

/// The outward (dispatch) register. One row per document leaving the office.
/// Vocabulary and legal moves: src/lib/outward.ts.
model OutwardEntry {
  id            String  @id @default(uuid())
  /// OUT/2026/000001
  outwardNumber String  @unique
  applicationId String?

  /// BPO | SHORTFALL_LETTER | SHOW_CAUSE_NOTICE | REVOCATION_ORDER |
  /// REGISTRATION_LETTER | OCCUPANCY_CERTIFICATE | OTHER
  documentType      String
  /// The number printed on the document itself — SCN/…, ROR/…, BP/…
  documentReference String @default("")
  /// ShowCauseNotice | RevocationProceeding | ApprovalOrder | Shortfall | ""
  sourceType        String @default("")
  sourceId          String @default("")
  subject           String @default("")

  recipient String
  address   String @default("")

  /// DRAFT | READY_FOR_DISPATCH | DISPATCHED | DELIVERED | ACKNOWLEDGED | RETURNED | CANCELLED
  status              String    @default("DRAFT")
  assignedDate        DateTime  @default(now())
  dispatchDate        DateTime?
  /// BY_HAND | REGISTERED_POST | SPEED_POST | COURIER | EMAIL | PORTAL
  mode                String    @default("")
  trackingNumber      String    @default("")
  deliveredAt         DateTime?
  returnedAt          DateTime?
  returnReason        String    @default("")
  /// Who acknowledged receipt, and how ("Signed receipt — owner").
  acknowledgement     String    @default("")
  acknowledgementDate DateTime?
  remarks             String    @default("")

  createdById   String?
  createdByName String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application?   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  events      OutwardEvent[]

  @@index([applicationId])
  @@index([status])
  @@index([documentType, status])
  @@index([sourceType, sourceId])
  @@map("outward_entries")
}

model OutwardEvent {
  id           String   @id @default(uuid())
  outwardId    String
  action       String
  fromStatus   String   @default("")
  toStatus     String
  actorId      String?
  actorName    String   @default("")
  actorRoleKey String   @default("")
  remarks      String   @default("")
  occurredAt   DateTime @default(now())

  outward OutwardEntry @relation(fields: [outwardId], references: [id], onDelete: Cascade)

  @@index([outwardId, occurredAt])
  @@map("outward_events")
}

// ═══════════════════════════════════════════════════════════════════════════
// Change of technical professional (Phase 8). See src/lib/professional-change.ts.
// ═══════════════════════════════════════════════════════════════════════════

/// A request to replace the technical professional (LTP) on a file.
/// PENDING_VERIFICATION → UNDER_REVIEW → PENDING_DECISION → APPROVED | REJECTED.
model ProfessionalChangeRequest {
  id            String @id @default(uuid())
  /// TPC/2026/000001
  requestNumber String @unique
  applicationId String
  status        String @default("PENDING_VERIFICATION")

  /// Who held the file when the request was made, and who is proposed.
  /// The snapshots freeze licence, class, validity and firm as they stood.
  currentProfessionalId  String
  currentSnapshot        Json   @default(dbgenerated("'{}'"))
  proposedProfessionalId String
  proposedSnapshot       Json   @default(dbgenerated("'{}'"))

  /// The owner making the request, as the file names them at that moment.
  ownerName   String   @default("")
  /// The date on the owner's request letter.
  requestDate DateTime
  reason      String
  /// [{ kind, fileObjectId|null, fileName, mimeType, sizeBytes, isDemo, addedAt, addedByName }]
  documents   Json     @default(dbgenerated("'[]'"))

  /// The role whose step is next, recorded at each move. Empty once decided.
  currentDeskRoleKey String @default("")

  requestedById      String?
  requestedByName    String   @default("")
  requestedByRoleKey String   @default("")
  /// The stage the file was at when the request was registered.
  requestedStageCode String   @default("")
  requestedAt        DateTime @default(now())
  requestSequence    Int?

  verifiedById        String?
  verifiedByName      String    @default("")
  verifiedByRoleKey   String    @default("")
  verifiedAt          DateTime?
  verificationRemarks String    @default("")

  reviewedById      String?
  reviewedByName    String    @default("")
  reviewedByRoleKey String    @default("")
  reviewedAt        DateTime?
  reviewRemarks     String    @default("")

  /// APPROVED | REJECTED
  decision         String    @default("")
  decisionRemarks  String    @default("")
  decidedById      String?
  decidedByName    String    @default("")
  decidedByRoleKey String    @default("")
  decidedAt        DateTime?
  decisionSequence Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application          Application               @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  currentProfessional  User                      @relation("ProfessionalChangeCurrent", fields: [currentProfessionalId], references: [id])
  proposedProfessional User                      @relation("ProfessionalChangeProposed", fields: [proposedProfessionalId], references: [id])
  events               ProfessionalChangeEvent[]

  @@index([applicationId])
  @@index([status])
  @@map("professional_change_requests")
}

/// Append-only by convention; the audit chain carries the same facts.
model ProfessionalChangeEvent {
  id           String   @id @default(uuid())
  requestId    String
  action       String
  fromStatus   String   @default("")
  toStatus     String
  actorId      String?
  actorName    String   @default("")
  actorRoleKey String   @default("")
  stageCode    String   @default("")
  remarks      String   @default("")
  occurredAt   DateTime @default(now())

  request ProfessionalChangeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, occurredAt])
  @@map("professional_change_events")
}

/// Every technical professional who has held a file, in order. Rows are opened
/// and closed, never deleted: exactly one is ACTIVE, and it names the same user
/// as applications.ltpUserId. A file filed before this table existed has no
/// row until its first change, which writes the original engagement first.
model ApplicationProfessional {
  id                     String    @id @default(uuid())
  applicationId          String
  userId                 String
  /// ACTIVE | SUPERSEDED
  status                 String    @default("ACTIVE")
  snapshot               Json      @default(dbgenerated("'{}'"))
  /// Whether this professional may submit drawings on the file.
  drawingRights          Boolean   @default(true)
  /// ORIGINAL_FILING | CHANGE_REQUEST
  source                 String
  engagedFrom            DateTime
  engagedUntil           DateTime?
  /// The approved request that brought this professional in.
  changeRequestId        String?
  /// The approved request that replaced them.
  endedByChangeRequestId String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])

  @@index([applicationId, status])
  @@index([userId])
  @@map("application_professionals")
}

// ═══════════════════════════════════════════════════════════════════════════
// Commencement of work (Phase 9). See src/lib/commencement.ts.
// ═══════════════════════════════════════════════════════════════════════════

/// The owner's notice that work has started (or will start) under an issued
/// building permission order. One per file; written only by the workflow
/// effect WORK_COMMENCEMENT. "Pending commencement" vs "Work initiated" is
/// derived from commencementDate, never stored.
model WorkCommencement {
  id                 String @id @default(uuid())
  /// WCN/2026/000001
  commencementNumber String @unique
  applicationId      String @unique
  /// NOTIFIED — the one stored state today; room for a later lifecycle.
  status             String @default("NOTIFIED")

  /// The proceeding worked under, frozen as it stood on the day.
  approvalOrderId String
  orderNumber     String
  orderIssuedAt   DateTime
  orderValidUntil DateTime?

  ownerName    String @default("")
  /// The technical professional holding the file when the notice was given.
  ltpUserId    String
  ltpName      String @default("")
  ltpLicenceNo String @default("")

  contractorName      String
  contractorLicenceNo String @default("")
  contractorPhone     String @default("")
  contractorAddress   String @default("")

  /// The day work starts on site. May be later than the notice.
  commencementDate DateTime
  /// When the notice was given — the workflow step's moment.
  notifiedAt       DateTime
  /// [{ kind, fileObjectId|null, fileName, mimeType, sizeBytes, isDemo, addedAt, addedByName }]
  documents        Json     @default(dbgenerated("'[]'"))
  remarks          String   @default("")

  notifiedById      String?
  notifiedByName    String  @default("")
  notifiedByRoleKey String  @default("")
  stageCode         String  @default("")
  workflowSequence  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([commencementDate])
  @@map("work_commencements")
}

// ═══════════════════════════════════════════════════════════════════════════
// Occupancy (Phase 10). See src/lib/occupancy.ts.
// ═══════════════════════════════════════════════════════════════════════════

/// One application for occupancy on a permitted building. Written only by the
/// workflow effect OCCUPANCY. At most one is open per file (`isCurrent` marks
/// the latest); a rejected one may be followed by a fresh one.
model OccupancyApplication {
  id              String  @id @default(uuid())
  /// OCC/2026/000001
  occupancyNumber String  @unique
  applicationId   String
  /// SUBMITTED | INSPECTION_PENDING | INSPECTION_COMPLETED | SHORTFALL |
  /// RECOMMENDED | APPROVED | CERTIFICATE_ISSUED | REJECTED
  status          String  @default("SUBMITTED")
  /// The latest application on the file — the register shows only this one.
  isCurrent       Boolean @default(true)
  /// 1, then +1 each time a shortfall is answered and the building re-inspected.
  round           Int     @default(1)

  // The permission and the work it completes, frozen as they stood.
  approvalOrderId    String
  orderNumber        String
  commencementNumber String    @default("")
  commencementDate   DateTime?
  ownerName          String    @default("")
  ltpUserId          String
  ltpName            String    @default("")
  ltpLicenceNo       String    @default("")
  /// The sanctioned figures (from the BPO snapshot) the building is measured against.
  approvedFigures    Json      @default(dbgenerated("'{}'"))

  // ── Completion intimation ────────────────────────────────────────────
  completionDate    DateTime
  completionRemarks String   @default("")
  /// [{ kind, fileObjectId|null, fileName, mimeType, sizeBytes, isDemo, addedAt, addedByName, round }]
  documents         Json     @default(dbgenerated("'[]'"))
  submittedById     String?
  submittedByName   String   @default("")
  submittedAt       DateTime @default(now())

  // ── The reviewing desk: as-built review and recommendation ───────────
  /// APPROVE | REJECT
  recommendation      String    @default("")
  recommendationNotes String    @default("")
  reviewedById        String?
  reviewedByName      String    @default("")
  reviewedByRoleKey   String    @default("")
  reviewedAt          DateTime?

  // ── Shortfall (current round) ────────────────────────────────────────
  shortfallItems        Json      @default(dbgenerated("'[]'"))
  shortfallRemarks      String    @default("")
  shortfallRaisedByName String    @default("")
  shortfallRaisedAt     DateTime?
  shortfallResponse     String    @default("")
  shortfallRespondedAt  DateTime?

  // ── Decision ─────────────────────────────────────────────────────────
  /// APPROVED | REJECTED
  decision         String    @default("")
  decisionRemarks  String    @default("")
  decidedById      String?
  decidedByName    String    @default("")
  decidedByRoleKey String    @default("")
  decidedAt        DateTime?

  // ── Certificate ──────────────────────────────────────────────────────
  /// OC/2026/000001
  certificateNumber       String?   @unique
  certificateIssuedAt     DateTime?
  certificateIssuedByName String    @default("")
  approvedAreaSqm         Float?
  completedAreaSqm        Float?
  certificateConditions   Json      @default(dbgenerated("'[]'"))
  /// Everything printed on the certificate. The PDF renders from this alone.
  certificateSnapshot     Json      @default(dbgenerated("'{}'"))
  outwardEntryId          String?
  outwardNumber           String    @default("")

  /// The role whose step is next. Empty once closed.
  currentDeskRoleKey String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  inspections OccupancyInspection[]
  events      OccupancyEvent[]

  @@index([applicationId, isCurrent])
  @@index([status])
  @@map("occupancy_applications")
}

/// One final inspection — one per round.
model OccupancyInspection {
  id            String @id @default(uuid())
  occupancyId   String
  applicationId String
  round         Int
  /// SCHEDULED | COMPLETED
  status        String @default("SCHEDULED")

  scheduledFor    DateTime
  inspectorId     String?
  inspectorName   String   @default("")
  scheduledByName String   @default("")
  scheduledAt     DateTime @default(now())

  inspectedAt          DateTime?
  siteCondition        String    @default("")
  actualConstruction   String    @default("")
  approvedConstruction String    @default("")
  deviations           String    @default("")
  remarks              String    @default("")
  /// [{ view, fileObjectId|null, fileName, mimeType, isDemo, capturedAt }]
  photos               Json      @default(dbgenerated("'[]'"))
  /// RECOMMENDED | SHORTFALL | REJECT
  recommendation       String    @default("")
  /// The figures found on site. See AS_BUILT_PARAMETERS.
  asBuiltFigures       Json      @default(dbgenerated("'{}'"))
  /// MEASURED | DEMO — demo figures are generated, never measured.
  asBuiltSource        String    @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  occupancy OccupancyApplication @relation(fields: [occupancyId], references: [id], onDelete: Cascade)

  @@unique([occupancyId, round])
  @@map("occupancy_inspections")
}

/// Append-only by convention; the audit chain carries the same facts.
model OccupancyEvent {
  id           String   @id @default(uuid())
  occupancyId  String
  action       String
  fromStatus   String   @default("")
  toStatus     String
  actorId      String?
  actorName    String   @default("")
  actorRoleKey String   @default("")
  remarks      String   @default("")
  occurredAt   DateTime @default(now())

  occupancy OccupancyApplication @relation(fields: [occupancyId], references: [id], onDelete: Cascade)

  @@index([occupancyId, occurredAt])
  @@map("occupancy_events")
}

// ═══════════════════════════════════════════════════════════════════════════
// Developer registration (Phase 11). See src/lib/developer-registration.ts.
// ═══════════════════════════════════════════════════════════════════════════

/// One application to register a developer with the authority — a first
/// registration or a renewal. It belongs to no building permission file.
///
/// DRAFT → SUBMITTED → IN_PROCESS ⇄ SHORTFALL → VERIFIED → APPROVED | REJECTED,
/// and an APPROVED registration becomes EXPIRED when its validity lapses.
///
/// A renewal is a NEW row (`kind` RENEWAL, `renewalOfId` → the registration it
/// renews) carrying the same `registrationNumber` and `lineageId`. Rows are
/// never re-used: an approved registration is a signed record, and renewing it
/// must not rewrite the validity it was issued with. `isCurrent` marks the one
/// row per developer the register shows.
model DeveloperRegistration {
  id                 String  @id @default(uuid())
  /// DRA/2026/000001 — the application's own reference, allocated with the draft.
  applicationNumber  String  @unique
  /// NEW | RENEWAL
  kind               String  @default("NEW")
  /// DEV/2026/000001 — allocated when a NEW registration is approved; a renewal carries its predecessor's.
  registrationNumber String?
  /// The id of the first registration in this developer's chain. Every renewal shares it.
  lineageId          String
  renewalOfId        String?
  isCurrent          Boolean @default(true)
  /// DRAFT | SUBMITTED | IN_PROCESS | SHORTFALL | VERIFIED | APPROVED | REJECTED | EXPIRED
  status             String  @default("DRAFT")
  /// 1, then +1 each time a shortfall is answered.
  round              Int     @default(1)

  // ── The developer ────────────────────────────────────────────────────
  developerType         String
  developerName         String
  organization          String    @default("")
  authorizedPerson      String
  authorizedDesignation String    @default("")
  address               String
  district              String    @default("")
  pincode               String    @default("")
  mobile                String
  email                 String
  pan                   String    @default("")
  gstin                 String    @default("")
  // ── Registration information ─────────────────────────────────────────
  /// CIN / LLPIN / firm or society registration number, as the type calls for.
  incorporationNo       String    @default("")
  incorporationDate     DateTime?
  reraNo                String    @default("")
  experienceYears       Int?
  projectsCompleted     Int?
  registrationInfo      String    @default("")

  /// [{ kind, fileObjectId|null, fileName, mimeType, sizeBytes, isDemo, addedAt, addedByName, round, carriedForward }]
  documents Json @default(dbgenerated("'[]'"))

  // ── Submission ───────────────────────────────────────────────────────
  submittedById   String?
  submittedByName String    @default("")
  submittedAt     DateTime?

  // ── Scrutiny: taken up, shortfall, verification ──────────────────────
  takenUpById           String?
  takenUpByName         String    @default("")
  takenUpAt             DateTime?
  shortfallItems        Json      @default(dbgenerated("'[]'"))
  shortfallRemarks      String    @default("")
  shortfallRaisedByName String    @default("")
  shortfallRaisedAt     DateTime?
  shortfallResponse     String    @default("")
  shortfallRespondedAt  DateTime?
  /// RECOMMEND_APPROVAL | RECOMMEND_REJECTION
  verificationOutcome   String    @default("")
  verificationRemarks   String    @default("")
  verifiedById          String?
  verifiedByName        String    @default("")
  verifiedByRoleKey     String    @default("")
  verifiedAt            DateTime?

  // ── Decision ─────────────────────────────────────────────────────────
  /// APPROVED | REJECTED
  decision         String    @default("")
  decisionRemarks  String    @default("")
  decidedById      String?
  decidedByName    String    @default("")
  decidedByRoleKey String    @default("")
  decidedAt        DateTime?

  // ── Validity (set at approval, from the demo settings in force then) ──
  issueDate         DateTime?
  validFrom         DateTime?
  validTo           DateTime?
  renewalDueDate    DateTime?
  validityYears     Int?
  expiredAt         DateTime?
  /// When a later renewal replaced this registration as the current one.
  supersededAt      DateTime?
  /// When the "renewal due" notice went out — once per registration.
  renewalNotifiedAt DateTime?

  outwardEntryId String?
  outwardNumber  String  @default("")

  /// The role whose step is next. Empty once closed.
  currentDeskRoleKey String @default("")

  createdById   String?
  createdByName String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  events DeveloperRegistrationEvent[]

  @@index([isCurrent, status])
  @@index([status])
  @@index([lineageId])
  @@index([registrationNumber])
  @@index([pan])
  @@index([validTo])
  @@map("developer_registrations")
}

/// Append-only by convention; the audit chain carries the same facts.
model DeveloperRegistrationEvent {
  id             String   @id @default(uuid())
  registrationId String
  action         String
  fromStatus     String   @default("")
  toStatus       String
  actorId        String?
  actorName      String   @default("")
  actorRoleKey   String   @default("")
  remarks        String   @default("")
  occurredAt     DateTime @default(now())

  registration DeveloperRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId, occurredAt])
  @@map("developer_registration_events")
}

// ═══════════════════════════════════════════════════════════════════════════
// Professional registration (Phase 12). See src/lib/professional-registration.ts.
// ═══════════════════════════════════════════════════════════════════════════

/// One application to register a professional — architect, engineer,
/// structural engineer, LTP or any type configured in master data
/// (PROFESSIONAL_TYPE) — or to renew that registration. Belongs to no file.
///
/// DRAFT → SUBMITTED → IN_PROCESS ⇄ SHORTFALL → VERIFIED → APPROVED | REJECTED,
/// and APPROVED → EXPIRED when the validity lapses. A renewal is a new row in
/// the same lineage, as for developers. `userId` links the portal account the
/// professional signs in with, when they have one — the register never holds a
/// second copy of a person the users table already holds.
model ProfessionalRegistration {
  id                 String  @id @default(uuid())
  /// PRA/2026/000001 — the application's own reference.
  applicationNumber  String  @unique
  /// NEW | RENEWAL
  kind               String  @default("NEW")
  /// ARC/2026/000001 etc. — prefix from the professional type; kept across renewals.
  registrationNumber String?
  lineageId          String
  renewalOfId        String?
  isCurrent          Boolean @default(true)
  /// DRAFT | SUBMITTED | IN_PROCESS | SHORTFALL | VERIFIED | APPROVED | REJECTED | EXPIRED
  status             String  @default("DRAFT")
  round              Int     @default(1)

  /// master_data PROFESSIONAL_TYPE code.
  professionalType String
  /// The portal account this professional signs in with, if any.
  userId           String?

  name             String
  licenceNo        String
  /// Council of Architecture, the state engineering council, the authority itself…
  registrationBody String
  qualification    String    @default("")
  experienceYears  Int?
  organization     String    @default("")
  address          String
  district         String    @default("")
  pincode          String    @default("")
  mobile           String
  email            String
  /// The licence's own validity, as the registration body issued it.
  licenceValidFrom DateTime?
  licenceValidTo   DateTime?

  consentGiven Boolean   @default(false)
  consentText  String    @default("")
  consentAt    DateTime?

  /// [{ kind, fileObjectId|null, fileName, mimeType, sizeBytes, isDemo, addedAt, addedByName, round,
  ///    carriedForward?, status: UPLOADED|VERIFIED|REJECTED, verifyRemarks, verifiedByName, verifiedAt }]
  documents Json @default(dbgenerated("'[]'"))

  submittedById   String?
  submittedByName String    @default("")
  submittedAt     DateTime?

  takenUpById   String?
  takenUpByName String    @default("")
  takenUpAt     DateTime?

  shortfallItems        Json      @default(dbgenerated("'[]'"))
  shortfallRemarks      String    @default("")
  shortfallRaisedByName String    @default("")
  shortfallRaisedAt     DateTime?
  shortfallResponse     String    @default("")
  shortfallRespondedAt  DateTime?

  /// RECOMMEND_APPROVAL | RECOMMEND_REJECTION
  verificationOutcome String    @default("")
  verificationRemarks String    @default("")
  verifiedById        String?
  verifiedByName      String    @default("")
  verifiedByRoleKey   String    @default("")
  verifiedAt          DateTime?

  /// APPROVED | REJECTED
  decision         String    @default("")
  decisionRemarks  String    @default("")
  decidedById      String?
  decidedByName    String    @default("")
  decidedByRoleKey String    @default("")
  decidedAt        DateTime?

  issueDate       DateTime?
  validFrom       DateTime?
  validTo         DateTime?
  renewalDueDate  DateTime?
  validityYears   Int?
  /// The registration was cut short to end with the licence.
  cappedByLicence Boolean   @default(false)
  expiredAt       DateTime?
  supersededAt    DateTime?

  outwardEntryId String?
  outwardNumber  String  @default("")

  currentDeskRoleKey String @default("")

  createdById   String?
  createdByName String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User?                           @relation("ProfessionalRegistrationUser", fields: [userId], references: [id])
  events ProfessionalRegistrationEvent[]

  @@index([isCurrent, status])
  @@index([status])
  @@index([lineageId])
  @@index([professionalType, licenceNo])
  @@index([userId])
  @@index([validTo])
  @@map("professional_registrations")
}

/// Append-only by convention; the audit chain carries the same facts.
model ProfessionalRegistrationEvent {
  id             String   @id @default(uuid())
  registrationId String
  action         String
  fromStatus     String   @default("")
  toStatus       String
  actorId        String?
  actorName      String   @default("")
  actorRoleKey   String   @default("")
  remarks        String   @default("")
  occurredAt     DateTime @default(now())

  registration ProfessionalRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId, occurredAt])
  @@map("professional_registration_events")
}
