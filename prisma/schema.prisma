model ApprovalOrder {
  id               String    @id @default(uuid())
  applicationId    String    @unique
  orderNumber      String    @unique
  status           String    @default("DRAFT")
  issuedById       String
  issuedAt         DateTime  @default(now())
  validUntil       DateTime?
  conditions       Json      @default(dbgenerated("'[]'"))
  storageKey       String    @default("")
  /// Frozen copy of everything printed on the order.
  snapshot         Json      @default(dbgenerated("'{}'"))
  /// Public verification token behind /verify-order/[code].
  verificationCode String    @unique
  /// Reserved for a future DSC / eSign integration (open question S3).
  signatureRef     String    @default("")
  revokedAt        DateTime?
  revokeReason     String    @default("")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

